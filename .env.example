# Rename this file to .env and add your Polygon API key.
# Never commit .env to git.
POLYGON_API_KEY=your_polygon_api_key_here

# Optional: local throttle for Polygon-heavy jobs.
# Paid plans can go faster, but this keeps large research downloads polite.
POLYGON_MIN_REQUEST_INTERVAL_SEC=0.20

# Absolute path to a directory of per-symbol {SYMBOL}.parquet files.
# Required when BUILDING THE MERGED STORE (python scripts/build_merged_dataset.py).
# Read only by src/data/pipeline/paths.py. It is NOT the parquet data provider:
# that reads the `parquet_data_dir` CONFIG key and never consults this variable.
# This project ships no dataset and depends on no particular source.
# Example (Windows): C:\Users\yourname\market-data\parquet
# Example (Mac/Linux): /home/yourname/market-data/parquet
NORGATE_DATA_ROOT=

# Absolute path to the SP500-Survivorship-bias-data-2004-2026 repo root.
# Required when portfolios contains "sp500_pit".
# Clone: git clone https://github.com/shardul0701/SP500-Survivorship-bias-data-2004-2026.git
SP500_DATA_ROOT=

# Absolute path to the NQ100-Survivorship-bias-data-2004-2026 repo root.
# Required when portfolios contains "nq100_pit" (or "pit:nq100").
# Clone: git clone https://github.com/shardul0701/NQ100-Survivorship-bias-data-2004-2026.git
NQ100_DATA_ROOT=

# Absolute path to the locally-built merged Norgate+Polygon store.
# Required when data_provider = "merged". Build it first:
#   python scripts/build_merged_dataset.py
MERGED_DATA_ROOT=
